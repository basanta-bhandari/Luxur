# Copy this file to .env (same folder) and fill in your keys.
Username=YourName
Assistantname=Luxur

GroqAPIKey=
CohereAPIKey=
HuggingFaceAPIKey=

# Speech recognition language (BCP-47), e.g. en, en-US, hi-IN
InputLanguage=en
# Any edge-tts voice name: run `edge-tts --list-voices`
AssistantVoice=en-CA-LiamNeural

# Optional model overrides
# GroqModel=openai/gpt-oss-120b
# CohereModel=command-a-plus-05-2026
# ImageModel=stabilityai/stable-diffusion-xl-base-1.0
